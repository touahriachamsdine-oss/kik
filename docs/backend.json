{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the application (traveler, agency, or admin).",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "name": {
          "type": "string",
          "description": "User's full name."
        },
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "User's phone number."
        },
        "role": {
          "type": "string",
          "description": "User's role (traveler, agency, or admin).",
          "enum": ["traveler", "agency", "admin"]
        },
        "profilePicture": {
          "type": "string",
          "description": "URL to the user's profile picture.",
          "format": "uri"
        },
        "verified": {
          "type": "boolean",
          "description": "Indicates whether the user's email is verified."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of when the user was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of when the user was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "phone",
        "role",
        "profilePicture",
        "verified",
        "createdAt",
        "updatedAt"
      ]
    },
    "Agency": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Agency",
      "type": "object",
      "description": "Represents a travel agency registered on the platform.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the agency."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:1 Agency) Unique identifier for the user associated with the agency."
        },
        "businessName": {
          "type": "string",
          "description": "Name of the agency."
        },
        "licenseNumber": {
          "type": "string",
          "description": "Agency's license number."
        },
        "address": {
          "type": "string",
          "description": "Agency's address."
        },
        "city": {
          "type": "string",
          "description": "City where the agency is located."
        },
        "wilaya": {
          "type": "string",
          "description": "Province where the agency is located."
        },
        "country": {
          "type": "string",
          "description": "Country where the agency is located."
        },
        "description": {
          "type": "string",
          "description": "Description of the agency."
        },
        "logo": {
          "type": "string",
          "description": "URL to the agency's logo.",
          "format": "uri"
        },
        "rating": {
          "type": "number",
          "description": "Average rating of the agency."
        },
        "totalReviews": {
          "type": "integer",
          "description": "Number of reviews for the agency."
        },
        "verified": {
          "type": "boolean",
          "description": "Indicates whether the agency is verified by an admin."
        },
        "verificationDocuments": {
          "type": "array",
          "description": "Array of URLs to the agency's verification documents.",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of when the agency was created.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "businessName",
        "licenseNumber",
        "address",
        "city",
        "wilaya",
        "country",
        "description",
        "logo",
        "verified",
        "createdAt"
      ]
    },
    "Package": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Package",
      "type": "object",
      "description": "Represents a travel package offered by an agency.",
      "properties": {
        "id": { "type": "string" },
        "agencyId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "destination": { "type": "string" },
        "durationDays": { "type": "integer" },
        "price": { "type": "number" },
        "maxParticipants": { "type": "integer" },
        "category": { "type": "string" },
        "includes": { "type": "array", "items": { "type": "string" } },
        "excludes": { "type": "array", "items": { "type": "string" } },
        "images": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "rating": { "type": "number" },
        "featured": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "inactive", "draft"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "agencyId", "title", "description", "destination", "durationDays",
        "price", "maxParticipants", "category", "includes", "excludes", "images",
        "featured", "status", "createdAt", "updatedAt"
      ]
    },
    "Booking": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Booking",
      "type": "object",
      "description": "Represents a booking made by a user for a travel package.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "packageId": { "type": "string" },
        "agencyId": { "type": "string" },
        "bookingDate": { "type": "string", "format": "date-time" },
        "travelDate": { "type": "string", "format": "date-time" },
        "numTravelers": { "type": "integer" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled", "completed"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "refunded"] },
        "paymentMethod": { "type": "string" },
        "paymentId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "userId", "packageId", "agencyId", "bookingDate", "travelDate",
        "numTravelers", "totalPrice", "status", "paymentStatus", "createdAt", "updatedAt"
      ]
    },
    "Review": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Review",
      "type": "object",
      "description": "Represents a review of a travel package or agency.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "packageId": { "type": "string" },
        "agencyId": { "type": "string" },
        "bookingId": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "verifiedBooking": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "packageId", "agencyId", "bookingId", "rating", "comment", "verifiedBooking", "createdAt"]
    },
    "Payment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Payment",
      "type": "object",
      "description": "Represents a payment made for a booking.",
      "properties": {
        "id": { "type": "string" },
        "bookingId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "method": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed", "refunded"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "bookingId", "amount", "currency", "method", "transactionId", "status", "createdAt"]
    },
    "Destination": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Destination",
      "type": "object",
      "description": "Represents a travel destination.",
      "properties": {
        "id": { "type": "string" },
        "name_ar": { "type": "string" },
        "name_fr": { "type": "string" },
        "name_en": { "type": "string" },
        "country": { "type": "string" },
        "wilaya": { "type": "string" },
        "description": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "coordinates": { "type": "object", "properties": { "lat": {"type": "number"}, "lng": {"type": "number"}} },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name_ar", "name_fr", "name_en", "country", "description", "images", "coordinates", "featured", "createdAt"]
    },
    "BlogPost": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "BlogPost",
      "type": "object",
      "description": "Represents a blog post.",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "publishedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorId", "title", "content", "category", "images", "publishedAt"]
    },
    "Wishlist": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Wishlist",
      "type": "object",
      "description": "Represents a user's wishlist of travel packages.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "packageId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "packageId", "createdAt"]
    },
    "Notification": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Notification",
      "type": "object",
      "description": "Represents a notification sent to a user.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "title", "message", "read", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "google.com",
      "facebook.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/entities/User" },
          "description": "Stores user profile information."
        }
      },
      {
        "path": "/agencies/{agencyId}",
        "definition": {
          "entityName": "Agency",
          "schema": { "$ref": "#/entities/Agency" },
          "description": "Stores travel agency information."
        }
      },
      {
        "path": "/packages/{packageId}",
        "definition": {
          "entityName": "Package",
          "schema": { "$ref": "#/entities/Package" },
          "description": "Stores travel package information."
        }
      },
      {
        "path": "/bookings/{bookingId}",
        "definition": {
          "entityName": "Booking",
          "schema": { "$ref": "#/entities/Booking" },
          "description": "Stores booking information."
        }
      },
      {
        "path": "/reviews/{reviewId}",
        "definition": {
          "entityName": "Review",
          "schema": { "$ref": "#/entities/Review" },
          "description": "Stores review information."
        }
      },
      {
        "path": "/payments/{paymentId}",
        "definition": {
          "entityName": "Payment",
          "schema": { "$ref": "#/entities/Payment" },
          "description": "Stores payment information related to bookings."
        }
      },
      {
        "path": "/destinations/{destinationId}",
        "definition": {
          "entityName": "Destination",
          "schema": { "$ref": "#/entities/Destination" },
          "description": "Stores destination information."
        }
      },
      {
        "path": "/blog_posts/{blogPostId}",
        "definition": {
          "entityName": "BlogPost",
          "schema": { "$ref": "#/entities/BlogPost" },
          "description": "Stores blog post information."
        }
      },
      {
        "path": "/users/{userId}/wishlist/{wishlistId}",
        "definition": {
          "entityName": "Wishlist",
          "schema": { "$ref": "#/entities/Wishlist" },
          "description": "Stores wishlist items for each user."
        }
      },
      {
        "path": "/users/{userId}/notifications/{notificationId}",
        "definition": {
          "entityName": "Notification",
          "schema": { "$ref": "#/entities/Notification" },
          "description": "Stores notifications for each user."
        }
      }
    ]
  }
}

    