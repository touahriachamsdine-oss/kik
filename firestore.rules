rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isTraveler(userId) {
      return getUserData(userId).role == 'traveler';
    }

    function isAgency(userId) {
      return getUserData(userId).role == 'agency';
    }

    function isAdmin(userId) {
      return getUserData(userId).role == 'admin';
    }
    
    function isAgencyOwnerOfPackage(package) {
      return isAgency(request.auth.uid) && package.agencyId == get(/databases/$(database)/documents/agencies/$(request.auth.uid)).id;
    }
    
    function isAgencyOwner(agencyId) {
      return isAgency(request.auth.uid) && agencyId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      // Admins can read/write any user. Users can only read/write their own data.
      allow read, write: if isAdmin(request.auth.uid) || isOwner(userId);
    }

    match /agencies/{agencyId} {
      // Publicly readable, writable only by the owner agency or admin.
      allow get, list: if isSignedIn();
      allow create: if isAgency(request.auth.uid);
      allow update: if isAdmin(request.auth.uid) || isAgencyOwner(agencyId);
      allow delete: if isAdmin(request.auth.uid);
    }

    match /packages/{packageId} {
      // Publicly readable. Writable by owning agency or admin.
      allow read: if true;
      allow create: if isAgency(request.auth.uid);
      allow update, delete: if isAdmin(request.auth.uid) || isAgencyOwnerOfPackage(resource.data);
    }

    match /bookings/{bookingId} {
      // Readable by traveler who owns it, agency who owns the package, or admin.
      allow get: if isAdmin(request.auth.uid) || isOwner(resource.data.userId) || isAgencyOwnerOfPackage(get(/databases/$(database)/documents/packages/$(resource.data.packageId)).data);
      // Creatable by the traveler.
      allow create: if isTraveler(request.auth.uid) && isOwner(request.resource.data.userId);
      // Updatable by agency or admin.
      allow update: if isAdmin(request.auth.uid) || isAgencyOwnerOfPackage(get(/databases/$(database)/documents/packages/$(resource.data.packageId)).data);
      // Deletable by traveler (cancellation) or admin.
      allow delete: if isAdmin(request.auth.uid) || isOwner(resource.data.userId);
    }

    match /reviews/{reviewId} {
      // Publicly readable.
      allow read: if true;
      // Creatable by a traveler who has a completed booking for the package.
      function hasCompletedBooking() {
        let booking = get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data;
        return booking.userId == request.auth.uid && booking.status == 'completed';
      }
      allow create: if isTraveler(request.auth.uid) && isOwner(request.resource.data.userId) && hasCompletedBooking();
      // Updatable/Deletable by the review author or admin.
      allow update, delete: if isAdmin(request.auth.uid) || isOwner(resource.data.userId);
    }

    match /payments/{paymentId} {
      // Readable by user who made booking, agency of booking, or admin
      allow read: if isAdmin(request.auth.uid) || isOwner(get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.userId) || isAgencyOwnerOfPackage(get(/databases/$(database)/documents/packages/$(get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.packageId)).data);
      // Writable only by server-side logic (or admin for emergencies)
      allow write: if isAdmin(request.auth.uid);
    }

    match /destinations/{destinationId} {
      // Publicly readable, admin writable.
      allow read: if true;
      allow write: if isAdmin(request.auth.uid);
    }

    match /blog_posts/{blogPostId} {
      // Publicly readable.
      allow read: if true;
      // Creatable/Writable by owning agency or admin.
      allow create: if isAgency(request.auth.uid);
      allow update, delete: if isAdmin(request.auth.uid) || (isAgency(request.auth.uid) && resource.data.authorId == request.auth.uid);
    }

    match /users/{userId}/wishlist/{wishlistId} {
      // Only the user can manage their own wishlist.
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/notifications/{notificationId} {
      // Only the user can manage their own notifications.
      allow read, write: if isOwner(userId);
    }
  }
}
