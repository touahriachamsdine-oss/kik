rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isTraveler(userId) {
      return getUserData(userId).role == 'traveler';
    }

    function isAgency(userId) {
      return getUserData(userId).role == 'agency';
    }

    function isAdmin(userId) {
      return getUserData(userId).role == 'admin';
    }

    function isAgencyOwner(agencyDoc) {
      return isSignedIn() && agencyDoc.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      // Admins can read/write any user. Users can only read/write their own data.
      allow read, write: if isAdmin(request.auth.uid) || isOwner(userId);
    }

    match /agencies/{agencyId} {
      // Publicly readable, writable only by the owner agency or admin.
      allow get, list: if isSignedIn();
      allow create: if isAgency(request.auth.uid);
      allow update: if isAdmin(request.auth.uid) || isAgencyOwner(resource);
      allow delete: if isAdmin(request.auth.uid);
    }

    match /packages/{packageId} {
      // Publicly readable. Writable by owning agency or admin.
      allow read: if true;
      allow create: if isAgency(request.auth.uid) && request.resource.data.agencyId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.agencyId;
      allow update, delete: if isAdmin(request.auth.uid) || (isAgency(request.auth.uid) && resource.data.agencyId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.agencyId);
    }

    match /bookings/{bookingId} {
      // Readable by traveler, agency, or admin.
      // Creatable by the traveler.
      // Updatable (e.g., status change) by agency or admin.
      // Deletable by traveler (cancellation) or admin.
      allow get: if isAdmin(request.auth.uid) || isOwner(resource.data.userId) || (isAgency(request.auth.uid) && resource.data.agencyId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.agencyId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isAdmin(request.auth.uid) || (isAgency(request.auth.uid) && resource.data.agencyId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.agencyId);
      allow delete: if isAdmin(request.auth.uid) || isOwner(resource.data.userId);
    }

    match /reviews/{reviewId} {
      // Publicly readable.
      // Creatable by a traveler who has a completed booking for the package.
      // Updatable/Deletable by the review author or admin.
      function hasCompletedBooking() {
        return exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)) &&
               get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == request.auth.uid &&
               get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'completed';
      }
      allow read: if true;
      allow create: if isOwner(request.resource.data.userId) && hasCompletedBooking();
      allow update, delete: if isAdmin(request.auth.uid) || isOwner(resource.data.userId);
    }

    match /payments/{paymentId} {
      // Highly restricted. Server-side (admin) logic only.
      allow read, write: if isAdmin(request.auth.uid);
    }

    match /destinations/{destinationId} {
      // Publicly readable, admin writable.
      allow read: if true;
      allow write: if isAdmin(request.auth.uid);
    }

    match /blog_posts/{blogPostId} {
      // Publicly readable, admin/author writable.
      allow read: if true;
      allow create, update, delete: if isAdmin(request.auth.uid) || isOwner(resource.data.authorId);
    }

    match /users/{userId}/wishlist/{wishlistId} {
      // Only the user can manage their own wishlist.
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/notifications/{notificationId} {
      // Only the user can manage their own notifications.
      allow read, write: if isOwner(userId);
    }
  }
}

    